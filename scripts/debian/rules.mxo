#!/usr/bin/make -f

export DEB_BUILD_MAINT_OPTIONS = hardening=+all
include /usr/share/dpkg/architecture.mk

%:
	dh $@

override_dh_auto_configure:
	cmake -S src-5 -B build-qt5 \
		-DCMAKE_C_FLAGS="$(CFLAGS) -D_FORTIFY_SOURCE=2" \
		-DCMAKE_CXX_FLAGS="$(CXXFLAGS) -D_FORTIFY_SOURCE=2" \
		-DCMAKE_EXE_LINKER_FLAGS="$(LDFLAGS)"

override_dh_auto_build:
	$(MAKE) -C build-qt5

override_dh_auto_install:
	cp data/profile.sh debian/qt5-style-globalqss.sh
	$(MAKE) -C build-qt5 install DESTDIR=$(CURDIR)/debian/tmp
